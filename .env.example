# ============ Aplikasi ============
# Password admin untuk masuk ke aplikasi
ADMIN_PASSWORD=admin123
# Kunci rahasia penanda tangan cookie sesi (acak & panjang)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang
PORT=3000

# ============ Database MySQL ============
# Cara 1 — connection string (dipakai Railway secara otomatis lewat MYSQL_URL)
# MYSQL_URL=mysql://user:password@host:3306/railway

# Cara 2 — variabel terpisah (default cocok untuk XAMPP di lokal)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=presensi
